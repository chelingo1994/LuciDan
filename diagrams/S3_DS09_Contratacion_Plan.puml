@startuml

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam maxMessageSize 180
skinparam sequenceArrowThickness 1
skinparam ArrowColor #632423
skinparam ArrowFontColor #2B1D14
skinparam ArrowFontSize 11
skinparam sequence {
  ActorBorderColor #632423
  ActorBackgroundColor #FFF6F0
  ActorFontColor #2B1D14
  ParticipantBorderColor #632423
  ParticipantBackgroundColor #FFF6F0
  ParticipantFontColor #632423
  ParticipantFontStyle bold
  LifeLineBorderColor #8A7A6C
  LifeLineBackgroundColor #FFF6F0
  BoxBorderColor #632423
  BoxFontColor #632423
  BoxBackgroundColor #FFF9F5
  DividerBorderColor #632423
  DividerBackgroundColor #F2E4DE
  DividerFontColor #632423
}
skinparam titleFontColor #632423
skinparam titleFontSize 18
skinparam titleFontStyle bold
skinparam noteBackgroundColor #FFF9E8
skinparam noteBorderColor #8A7A6C


title DS09 — Contratación de un plan de publicidad (HU10)
autonumber
actor "Dueño de Negocio" as U
participant "PlanesScreen" as UI
participant "PlanViewModel" as VM
participant "ContratacionRepository" as CREPO
participant "NegocioRepository" as NREPO
database "Base de Datos\n(Room)" as DB

U -> UI : seleccionar plan de publicidad
UI -> VM : contratarPlan(negocioId, planId)
VM -> CREPO : registrarContratacion(negocioId, planId)
CREPO -> CREPO : calcular fechaVencimiento
CREPO -> DB : INSERT INTO contrataciones_publicidad
DB --> CREPO : ok
CREPO -> NREPO : actualizarEstadoDestacado(negocioId, true)
NREPO -> DB : UPDATE negocios SET destacado = true
DB --> NREPO : ok
NREPO --> CREPO : negocio actualizado
CREPO --> VM : contratación registrada
VM --> UI : mostrar confirmación
UI --> U : "Negocio destacado activo"

... al vencer el plan (proceso programado) ...
NREPO -> DB : UPDATE negocios SET destacado = false\nWHERE fecha_vencimiento < hoy

@enduml
