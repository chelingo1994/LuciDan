@startuml

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classFontColor #2B1D14
skinparam classFontSize 13
skinparam classBorderColor #632423
skinparam classBackgroundColor #FFF6F0
skinparam classAttributeFontColor #2B1D14
skinparam classAttributeFontSize 11
skinparam ArrowColor #8A7A6C
skinparam ArrowFontColor #632423
skinparam ArrowFontSize 11
skinparam titleFontColor #632423
skinparam titleFontSize 20
skinparam titleFontStyle bold


title
Diagrama Entidad-Relación — LuciDan App
Base de datos, Sprints 1-3
end title
skinparam linetype ortho

entity "usuarios" as usuarios {
  * id : INTEGER <<PK>>
  --
  correo : TEXT
  contrasena_hash : TEXT
  fecha_registro : DATE
  rol : TEXT
  notificaciones_activas : BOOLEAN
}

entity "lugares" as lugares {
  * id : INTEGER <<PK>>
  --
  nombre : TEXT
  categoria : TEXT
  latitud : REAL
  longitud : REAL
  descripcion : TEXT
  horario : TEXT
  rango_precio : TEXT
}

entity "resenas" as resenas {
  * id : INTEGER <<PK>>
  --
  usuario_id : INTEGER <<FK>>
  lugar_id : INTEGER <<FK>>
  calificacion : INTEGER
  comentario : TEXT
  fecha : DATE
}

entity "favoritos" as favoritos {
  * id : INTEGER <<PK>>
  --
  usuario_id : INTEGER <<FK>>
  lugar_id : INTEGER <<FK>>
  fecha_guardado : DATE
}

entity "negocios" as negocios {
  * id : INTEGER <<PK>>
  --
  usuario_id : INTEGER <<FK>>
  nombre : TEXT
  categoria : TEXT
  ubicacion : TEXT
  horario : TEXT
  estado : TEXT
  destacado : BOOLEAN
}

entity "planes_publicidad" as planes {
  * id : INTEGER <<PK>>
  --
  nombre : TEXT
  duracion_dias : INTEGER
  precio : REAL
  beneficios : TEXT
}

entity "contrataciones_publicidad" as contrataciones {
  * id : INTEGER <<PK>>
  --
  negocio_id : INTEGER <<FK>>
  plan_id : INTEGER <<FK>>
  fecha_inicio : DATE
  fecha_vencimiento : DATE
  activo : BOOLEAN
}

entity "estadisticas_negocio" as estadisticas {
  * id : INTEGER <<PK>>
  --
  negocio_id : INTEGER <<FK>>
  tipo : TEXT
  fecha : DATE
}

usuarios ||--o{ resenas
lugares  ||--o{ resenas
usuarios ||--o{ favoritos
lugares  ||--o{ favoritos
usuarios ||--o| negocios
negocios ||--o{ contrataciones
planes   ||--o{ contrataciones
negocios ||--o{ estadisticas

@enduml
