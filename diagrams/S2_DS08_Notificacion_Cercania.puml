@startuml

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam maxMessageSize 180
skinparam sequenceArrowThickness 1
skinparam ArrowColor #632423
skinparam ArrowFontColor #2B1D14
skinparam ArrowFontSize 11
skinparam sequence {
  ActorBorderColor #632423
  ActorBackgroundColor #FFF6F0
  ActorFontColor #2B1D14
  ParticipantBorderColor #632423
  ParticipantBackgroundColor #FFF6F0
  ParticipantFontColor #632423
  ParticipantFontStyle bold
  LifeLineBorderColor #8A7A6C
  LifeLineBackgroundColor #FFF6F0
  BoxBorderColor #632423
  BoxFontColor #632423
  BoxBackgroundColor #FFF9F5
  DividerBorderColor #632423
  DividerBackgroundColor #F2E4DE
  DividerFontColor #632423
}
skinparam titleFontColor #632423
skinparam titleFontSize 18
skinparam titleFontStyle bold
skinparam noteBackgroundColor #FFF9E8
skinparam noteBorderColor #8A7A6C


title DS08 — Notificación de cercanía (HU13)
autonumber
participant "LocationService" as GPS
participant "GeofenceManager" as GEO
participant "NegocioRepository" as REPO
participant "NotificationService\n(notificación local)" as NOTIF
actor "Usuario" as U

GPS -> GEO : ubicación actualizada (periódica)
GEO -> REPO : buscarDestacadosCercanos(ubicacion, radio)
REPO --> GEO : negocio destacado / promoción activa
alt hay negocio destacado cercano y notificaciones activas
  GEO -> NOTIF : notificarNegocioCercano(negocio)
  NOTIF -> U : notificación local "Tienes un negocio destacado cerca"
  U -> NOTIF : tocar la notificación
  NOTIF --> U : abrir ficha del negocio
else sin coincidencias o notificaciones desactivadas
  GEO -> GEO : descartar (sin acción)
end

@enduml
