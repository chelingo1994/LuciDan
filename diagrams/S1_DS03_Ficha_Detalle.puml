@startuml

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam maxMessageSize 180
skinparam sequenceArrowThickness 1
skinparam ArrowColor #632423
skinparam ArrowFontColor #2B1D14
skinparam ArrowFontSize 11
skinparam sequence {
  ActorBorderColor #632423
  ActorBackgroundColor #FFF6F0
  ActorFontColor #2B1D14
  ParticipantBorderColor #632423
  ParticipantBackgroundColor #FFF6F0
  ParticipantFontColor #632423
  ParticipantFontStyle bold
  LifeLineBorderColor #8A7A6C
  LifeLineBackgroundColor #FFF6F0
  BoxBorderColor #632423
  BoxFontColor #632423
  BoxBackgroundColor #FFF9F5
  DividerBorderColor #632423
  DividerBackgroundColor #F2E4DE
  DividerFontColor #632423
}
skinparam titleFontColor #632423
skinparam titleFontSize 18
skinparam titleFontStyle bold
skinparam noteBackgroundColor #FFF9E8
skinparam noteBorderColor #8A7A6C


title DS03 — Visualización de la ficha de un negocio (HU04)
autonumber
actor "Visitante / Residente" as U
participant "HomeScreen" as UI1
participant "DetalleScreen" as UI2
participant "DetalleViewModel" as VM
participant "NegocioRepository" as REPO
database "Base de Datos\n(Room)" as DB
participant "Contacto\n(util)" as CTC
participant "WhatsApp /\nMarcador" as EXT

U -> UI1 : tocar marcador de un negocio
UI1 -> UI2 : navegar a DetalleScreen(negocioId)
UI2 -> VM : cargarFicha(negocioId)
VM -> REPO : obtenerNegocioPorId(negocioId)
REPO -> DB : SELECT * FROM negocios WHERE id = negocioId
DB --> REPO : datos del negocio (qué vende, fotos,\nhorario, teléfono, dirección)
REPO --> VM : Negocio
VM --> UI2 : actualizar estado (ficha)
UI2 --> U : mostrar ficha con descripción, fotos, horario\ny botón "WhatsApp · número" o "Llamar · número"\n(el botón no aparece si no hay teléfono)

opt el usuario toca el botón de contacto
  U -> UI2 : tocar "WhatsApp" o "Llamar"
  UI2 -> CTC : abrir(telefono)
  alt celular boliviano (8 dígitos, empieza con 6 o 7)
    CTC -> EXT : abrir chat https://wa.me/591XXXXXXXX
  else fijo o WhatsApp no instalado
    CTC -> EXT : abrir el marcador del teléfono
  end
end

@enduml
