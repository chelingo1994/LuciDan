@startuml

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam maxMessageSize 300
skinparam sequenceArrowThickness 1
skinparam ArrowColor #632423
skinparam ArrowFontColor #2B1D14
skinparam ArrowFontSize 11
skinparam sequence {
  ActorBorderColor #632423
  ActorBackgroundColor #FFF6F0
  ActorFontColor #2B1D14
  ParticipantBorderColor #632423
  ParticipantBackgroundColor #FFF6F0
  ParticipantFontColor #632423
  ParticipantFontStyle bold
  LifeLineBorderColor #8A7A6C
  LifeLineBackgroundColor #FFF6F0
  BoxBorderColor #632423
  BoxFontColor #632423
  BoxBackgroundColor #FFF9F5
  DividerBorderColor #632423
  DividerBackgroundColor #F2E4DE
  DividerFontColor #632423
}
skinparam titleFontColor #632423
skinparam titleFontSize 18
skinparam titleFontStyle bold
skinparam noteBackgroundColor #FFF9E8
skinparam noteBorderColor #8A7A6C

title DS13 — Elegir una foto y registrar un negocio (HU08, post-migración)
autonumber
actor "Dueño de Negocio" as U
participant "PanelNegocioScreen" as UI
participant "Galería\ndel teléfono" as GAL
participant "FotoNegocio\n(util)" as FOTO
participant "LocationService" as LOC
participant "NegocioViewModel" as VM
participant "NegocioRepository" as REPO
database "Base de Datos\n(Room)" as DB
participant "NubeService" as NUBE
database "Cloud Firestore" as FS

== Elegir la foto ==
U -> UI : tocar "Agregar foto"
UI -> GAL : abrir selector de imágenes
GAL --> UI : Uri de la foto elegida
UI -> FOTO : procesar(uri)
FOTO -> FOTO : leer las medidas (inJustDecodeBounds)\ny calcular la reducción
FOTO -> FOTO : decodificar la imagen reducida y\nguardarla como archivo local
alt foto procesada
  FOTO --> UI : ruta absoluta del archivo
  UI --> U : mostrar vista previa de la foto
else no se pudo leer o decodificar
  FOTO --> UI : error (se registra la causa en el log)
  UI --> U : "No se pudo cargar la foto"
end

== Completar el formulario ==
U -> UI : escribir nombre, rubro, descripción,\nteléfono (opcional), dirección y horario
U -> UI : tocar "Usar mi ubicación"
UI -> LOC : obtenerUbicacion()
LOC --> UI : latitud y longitud
UI --> U : mostrar la ubicación GPS

== Guardar el negocio ==
U -> UI : tocar "Guardar"
UI -> VM : registrarNegocio(datos)
VM -> VM : validar nombre, rubro, dirección y ubicación GPS;\nsi hay teléfono, validar su formato
alt datos válidos
  VM -> REPO : guardarNegocio(datos, estado = PENDIENTE)
  REPO -> DB : INSERT INTO negocios (usuarioId = dueño)
  DB --> REPO : ok
  REPO -> NUBE : subir(negocio)
  NUBE -> FS : set documento (la foto local no se sube)
  FS --> NUBE : ok
  NUBE --> REPO : ok
  note right of NUBE: Si la subida falla, el negocio\nqueda guardado en el teléfono.\nLa foto de la galería es un archivo\nlocal: otros teléfonos no la ven.
  REPO --> VM : negocio registrado
  VM --> UI : mostrar confirmación
  UI --> U : "Perfil pendiente de publicación"
else datos inválidos
  VM --> UI : indicar los campos con error
  UI --> U : resaltar errores en el formulario
end

@enduml
