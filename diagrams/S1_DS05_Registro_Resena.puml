@startuml

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam maxMessageSize 180
skinparam sequenceArrowThickness 1
skinparam ArrowColor #632423
skinparam ArrowFontColor #2B1D14
skinparam ArrowFontSize 11
skinparam sequence {
  ActorBorderColor #632423
  ActorBackgroundColor #FFF6F0
  ActorFontColor #2B1D14
  ParticipantBorderColor #632423
  ParticipantBackgroundColor #FFF6F0
  ParticipantFontColor #632423
  ParticipantFontStyle bold
  LifeLineBorderColor #8A7A6C
  LifeLineBackgroundColor #FFF6F0
  BoxBorderColor #632423
  BoxFontColor #632423
  BoxBackgroundColor #FFF9F5
  DividerBorderColor #632423
  DividerBackgroundColor #F2E4DE
  DividerFontColor #632423
}
skinparam titleFontColor #632423
skinparam titleFontSize 18
skinparam titleFontStyle bold
skinparam noteBackgroundColor #FFF9E8
skinparam noteBorderColor #8A7A6C


title DS05 — Registro de una reseña (HU06)
autonumber
actor "Usuario Registrado" as U
participant "DetalleScreen" as UI
participant "ResenaViewModel" as VM
participant "ResenaRepository" as REPO
participant "LugarRepository" as LREPO
database "Base de Datos\n(Room)" as DB

U -> UI : abrir formulario de reseña
UI -> VM : enviarResena(calificacion, comentario)
VM -> VM : validar sesión iniciada
alt sesión válida
  VM -> REPO : guardarResena(usuarioId, lugarId, calificacion, comentario)
  REPO -> DB : INSERT INTO resenas
  DB --> REPO : ok
  REPO -> LREPO : recalcularPromedio(lugarId)
  LREPO -> DB : UPDATE lugares SET promedio_calificacion
  DB --> LREPO : ok
  LREPO --> REPO : promedio actualizado
  REPO --> VM : reseña guardada
  VM --> UI : mostrar confirmación
  UI --> U : reseña publicada
else sin sesión
  VM --> UI : solicitar inicio de sesión
  UI --> U : mostrar aviso de inicio de sesión
end

@enduml
