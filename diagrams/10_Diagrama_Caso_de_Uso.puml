@startuml

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ActorBorderColor #632423
skinparam ActorBackgroundColor #FFF6F0
skinparam ActorFontColor #2B1D14
skinparam UsecaseBorderColor #632423
skinparam UsecaseBackgroundColor #FFF6F0
skinparam UsecaseFontColor #2B1D14
skinparam ArrowColor #8A7A6C
skinparam ArrowFontColor #632423
skinparam ArrowFontSize 11
skinparam rectangleBorderColor #632423
skinparam rectangleFontColor #632423
skinparam rectangleFontStyle bold
skinparam titleFontColor #632423
skinparam titleFontSize 20
skinparam titleFontStyle bold

title Diagrama de Caso de Uso — LuciDan App\nGuía de negocios de Bermejo

left to right direction

actor "Visitante /\nResidente" as V
actor "Usuario\nRegistrado" as UR
actor "Dueño de\nNegocio" as DN
actor "Administrador" as AD

V <|-- UR
UR <|-- DN

rectangle "Sistema LuciDan App" {
  usecase "UC01\nExplorar negocios en el mapa" as UC01
  usecase "UC02\nFiltrar por rubro" as UC02
  usecase "UC03\nBuscar desde un punto\ndel mapa" as UC03
  usecase "UC04\nConfigurar radio\nde búsqueda" as UC04
  usecase "UC05\nVer ficha de detalle\ndel negocio" as UC05
  usecase "UC06\nTrazar ruta al negocio" as UC06
  usecase "UC07\nCalificar y comentar\nun negocio" as UC07
  usecase "UC08\nGuardar negocio\ncomo favorito" as UC08
  usecase "UC09\nRegistrar perfil\nde negocio" as UC09
  usecase "UC10\nEditar perfil\nde negocio" as UC10
  usecase "UC11\nContratar plan\nde publicidad" as UC11
  usecase "UC12\nVer estadísticas\ndel negocio" as UC12
  usecase "UC13\nIniciar sesión /\nRegistrarse" as UC13
  usecase "UC14\nRecibir notificaciones\nde cercanía" as UC14
  usecase "UC15\nGestionar roles\ny permisos" as UC15
  usecase "UC16\nContactar negocio por\nWhatsApp o llamada" as UC16
  usecase "UC17\nElegir tema claro,\noscuro o del sistema" as UC17
}

V --> UC01
V --> UC05
V --> UC17
UC02 .> UC01 : «extend»
UC03 .> UC01 : «extend»
UC01 .> UC04 : «include»
UC06 .> UC05 : «extend»
UC07 .> UC05 : «extend»
UC08 .> UC05 : «extend»
UC16 .> UC05 : «extend»

UR --> UC07
UR --> UC08
UR --> UC13
UR --> UC14

DN --> UC09
DN --> UC10
DN --> UC11
DN --> UC12

AD --> UC13
AD --> UC15

legend bottom
  |= Notación |= Significado |
  | --\|> | Generalización (herencia entre actores) |
  | <<include>> | El caso base siempre ejecuta al incluido |
  | <<extend>> | El caso extendido es opcional/condicional |
endlegend

@enduml
