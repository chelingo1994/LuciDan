@startuml

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classFontColor #2B1D14
skinparam classFontSize 13
skinparam classBorderColor #632423
skinparam classBackgroundColor #FFF6F0
skinparam classAttributeFontColor #2B1D14
skinparam classAttributeFontSize 11
skinparam ArrowColor #8A7A6C
skinparam ArrowFontColor #632423
skinparam ArrowFontSize 11
skinparam titleFontColor #632423
skinparam titleFontSize 20
skinparam titleFontStyle bold


title
Diagrama de Clases — LuciDan App
Guía de negocios de Bermejo, Sprints 1-3
end title

class Usuario {
  -id: Long
  -correo: String
  -contrasenaHash: String
  -fechaRegistro: Date
  -rol: RolUsuario
  -notificacionesActivas: Boolean
  +registrarse()
  +iniciarSesion()
  +recuperarContrasena()
}

enum RolUsuario {
  VISITANTE
  NEGOCIO
  ADMINISTRADOR
}

class Negocio {
  -id: Long
  -nombre: String
  -categoria: Rubro
  -descripcion: String
  -telefono: String
  -latitud: Double
  -longitud: Double
  -direccion: String
  -horario: String
  -fotos: List<String>
  -promedioCalificacion: Double
  -estado: EstadoNegocio
  -destacado: Boolean
  -planNivel: Int
  -destacadoHasta: Long
  -facebook: String
  -instagram: String
  -tiktok: String
  -ofertaTexto: String
  -ofertaHasta: Long
  -verificado: Boolean
  +registrar()
  +editarPerfil()
  +calcularDistancia(origen)
}

enum Rubro {
  GASTRONOMIA
  FARMACIA_SALUD
  MODA_ROPA
  CAMBIO_MONEDA
  TRANSPORTE
  ALOJAMIENTO
  ABARROTES
  TECNOLOGIA
  SERVICIOS
  OTRO
}

enum EstadoNegocio {
  PENDIENTE
  PUBLICADO
  SUSPENDIDO
}

class Resena {
  -id: Long
  -calificacion: Int
  -comentario: String
  -fecha: Date
  +guardar()
}

class Favorito {
  -id: Long
  -fechaGuardado: Date
}

class PlanPublicidad {
  -id: Long
  -nombre: String
  -duracionDias: Int
  -precio: Decimal
  -beneficios: String
  -nivel: Int
}

class ContratacionPublicidad {
  -id: Long
  -fechaInicio: Date
  -fechaVencimiento: Date
  -activo: Boolean
  +calcularVencimiento()
}

class EstadisticaNegocio {
  -id: Long
  -tipo: TipoEvento
  -fecha: Date
}

enum TipoEvento {
  VISTA
  CLIC_COMO_LLEGAR
}

Usuario "1" *-- "1" RolUsuario
Usuario "1" -- "0..*" Resena : escribe >
Usuario "1" -- "0..*" Favorito : guarda >
Favorito "0..*" -- "1" Negocio
Negocio "1" -- "0..*" Resena : recibe >
Usuario "1" -- "0..*" Negocio : posee >
Negocio "1" *-- "1" EstadoNegocio
Negocio "1" *-- "1" Rubro
Negocio "1" -- "0..*" ContratacionPublicidad : contrata >
PlanPublicidad "1" -- "0..*" ContratacionPublicidad
Negocio "1" -- "0..*" EstadisticaNegocio : genera >
EstadisticaNegocio "1" *-- "1" TipoEvento

legend right
  |= Historia |= Clase |
  | HU01-HU05 | Negocio, Rubro (exploración, ficha, ruta) |
  | HU06 | Resena |
  | HU07 | Favorito |
  | HU08/HU09 | Negocio (registro y gestión) |
  | HU10 | PlanPublicidad, ContratacionPublicidad, Negocio (plan y beneficios) |
  | HU11 | EstadisticaNegocio |
  | HU12/HU14 | Usuario, RolUsuario |
endlegend

@enduml
